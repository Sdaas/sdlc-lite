{
  // Human-readable name shown in VS Code's UI.
  "name": "sdlc-lite (plugin dev)",

  // Build the image from our Dockerfile (relative to this file).
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Fix the container's name so it's the same regardless of which host path
  // the repo is cloned into (the devcontainer CLI otherwise derives the name
  // from a hash of the workspace folder path, which changes across clones).
  "runArgs": ["--name", "sdlc-lite-test"],

  // Run as the non-root user provided by the base image.
  "remoteUser": "vscode",

  // Reusable add-ons. The Node feature FIRST (provides node + npm), then the
  // official Claude Code feature (its auto-install needs npm). Declaring the
  // dependency explicitly avoids the "npm missing" build failure.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Persist Claude Code's config + login across rebuilds by mounting
  // ~/.claude to a Docker named volume (lives outside the disposable container,
  // and entirely separate from the Mac's ~/.claude).
  "mounts": [
    "source=sdlc-lite-claude,target=/home/vscode/.claude,type=volume"
  ],

  // In a Dev Container the toolchain should be pinned + reproducible (bump the
  // claude-code feature version + rebuild), not silently self-updating.
  "remoteEnv": {
    "DISABLE_AUTOUPDATER": "1"
  },

  // VS Code setup applied INSIDE the container (Python tooling for the real product).
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },

  // Runs ONCE after the container is created. (1) Docker may create the mounted
  // ~/.claude volume owned by root; make it writable by vscode. (2) Install the
  // PINNED /implement-feature toolchain (ruff/mypy/pytest/pytest-cov/mutmut/...) so
  // the workflow's Gate 0 preflight finds every tool. (3) Report versions.
  //
  // NOTE: the toolchain install runs under `sudo env "PATH=$PATH"`. `uv pip
  // install --system` writes into root-owned /usr/local/.../site-packages, so it
  // needs root; but `uv` lives on vscode's PATH (~/.local/bin), which bare `sudo`
  // discards — `env "PATH=$PATH"` carries it through so root can still find `uv`.
  //
  // mutmut is version-checked via package metadata, NOT `mutmut --version`:
  // mutmut 3.x eagerly loads its config on ANY invocation and hard-fails when run
  // outside a project with source to mutate. Metadata is a deterministic liveness check.
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && sudo env \"PATH=$PATH\" uv pip install --system -r sdlc-lite-plugin/toolchain/requirements-dev.txt && python --version && ruff --version && mypy --version && pytest --version && python -c \"import importlib.metadata as m; print('mutmut', m.version('mutmut'))\" && (claude --version || echo 'claude not on PATH yet (feature installs it)')",

  // Runs on EVERY start (create, restart, rebuild). Provisions our Claude Code UX
  // — status line, smart-rm hook, settings.json, and the ~/.claude.json first-run
  // state (issue #54) — from the templates in `.devcontainer/claude/`.
  //
  // The logic lives in a commented script rather than inline here: it is idempotent
  // by two different rules (refresh-always vs. seed-only-if-absent) and spans two
  // stores (the persisted ~/.claude volume vs. ~/.claude.json outside it), which a
  // JSON one-liner cannot explain. Read `.devcontainer/post-start.sh` for the why.
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
