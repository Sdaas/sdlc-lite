# Secrets — auth tokens for release-verify.sh (NEVER commit). Store CLAUDE_CODE_OAUTH_TOKEN
# (from `claude setup-token`) or ANTHROPIC_API_KEY here; keep it out of git entirely.
.env
.env.*
*.env
!.env.example

# Temp/scratch
*.tmp
*.log
.DS_Store

# /implement-feature per-run process artifacts (handoff files + run-log). Code the
# workflow writes lives in the repo's own src/tests and IS committed; these are not.
.implement-feature/
# Fallback guard-audit run-log written at the repo root when no active run dir exists.
if-runlog.jsonl

# Python (for the real product later)
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.mutmut-cache

# Node (if any local tooling)
node_modules/

# Devcontainer lock is intentionally NOT ignored (pin the toolchain)
