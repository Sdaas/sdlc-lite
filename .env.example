# .env.example — template for release-verify.sh auth. Copy to `.env` (git-ignored) and fill in.
#
# release-verify.sh runs the automated clean-room verification, which makes headless
# `claude -p` calls INSIDE the dev container. Those need non-interactive auth — supply ONE
# of the following. Never commit the real `.env` (only this .example is tracked).

# Preferred: a long-lived Claude-subscription token. Mint it once on your Mac with
#   claude setup-token
# and paste its output here (no quotes, no spaces around `=`):
CLAUDE_CODE_OAUTH_TOKEN=<token>

# Alternative (API-billed, not your subscription): a Console API key from
# https://platform.claude.com — use INSTEAD of the token above, not both.
# ANTHROPIC_API_KEY=sk-ant-api03-...
